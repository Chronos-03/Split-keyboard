(module "HongYan_EC11J_5DM15P1ZD15F7_Horizontal" (layer F.Cu)
  (descr "HongYan EC11J Horizontal Rotary Encoder with Switch (Datasheet EC11J-001)")
  (tags "Rotary Encoder Horizontal Right-Angle EC11 Dual Row")
  
  (fp_text reference "SW**" (at 0 -6.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "EC11J_Horiz" (at 0 4.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  
  ;; Courtyard / Body Outline (12.3mm width, 6.5mm depth)
  ;; Front face is 4.6mm ahead of the origin (Y = -4.6)
  ;; Rear face is 1.9mm behind the origin (Y = 1.9)
  (fp_line (start -6.15 -4.6) (end 6.15 -4.6) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.15 -4.6) (end 6.15 1.9) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.15 1.9) (end -6.15 1.9) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.15 1.9) (end -6.15 -4.6) (layer F.SilkS) (width 0.12))
  
  ;; Shaft outline (Protrudes 15mm from front face, L=15)
  (fp_line (start -3 -4.6) (end -3 -19.6) (layer F.Fab) (width 0.12))
  (fp_line (start 3 -4.6) (end 3 -19.6) (layer F.Fab) (width 0.12))
  (fp_line (start -3 -19.6) (end 3 -19.6) (layer F.Fab) (width 0.12))

  ;; Mechanical Mounting Tabs (Shield) - 12.5mm apart (Datasheet exact)
  (pad "MH1" thru_hole oval (at -6.25 0) (size 3.5 3.5) (drill 2.2) (layers *.Cu *.Mask))
  (pad "MH2" thru_hole oval (at 6.25 0) (size 3.5 3.5) (drill 2.2) (layers *.Cu *.Mask))
  
  ;; Row 1: Encoder Pins (3 pins, 2.5mm pitch, collinear with mechanical tabs)
  (pad "A" thru_hole circle (at -2.5 0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "C" thru_hole circle (at 0 0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))   
  (pad "B" thru_hole circle (at 2.5 0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  
  ;; Row 2: Switch Pins (2 pins, 5.0mm pitch)
  ;; Placed exactly 2.5mm behind the encoder pins
  (pad "D" thru_hole circle (at -2.5 2.5) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "E" thru_hole circle (at 2.5 2.5) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
)
